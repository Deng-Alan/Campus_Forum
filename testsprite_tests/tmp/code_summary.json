{
  "tech_stack": [
    "TypeScript",
    "Next.js 14",
    "React 18",
    "TailwindCSS",
    "Java 11",
    "Spring Boot 2.7",
    "PostgreSQL",
    "Redis",
    "MyBatis Plus",
    "JWT Authentication"
