        "frontend/app/register/page.tsx",
        "frontend/hooks/useAuth.ts",
        "frontend/lib/api.ts",
        "backend/src/main/java/com/campus/forum/controller/AuthController.java",
        "backend/src/main/java/com/campus/forum/service/impl/AuthServiceImpl.java"
