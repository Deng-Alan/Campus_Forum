      "files": [
        "frontend/components/UserSettings.tsx",
        "frontend/hooks/useUser.ts",
        "backend/src/main/java/com/campus/forum/controller/UserController.java",
        "backend/src/main/java/com/campus/forum/service/impl/UserServiceImpl.java"
      ]
    },
